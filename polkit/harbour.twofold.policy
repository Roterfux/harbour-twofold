<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>harbour-twofold</vendor>
  <!-- Asked for by Twofold to unlock its vault: the system dialog takes the fingerprint
       or the security code. auth_admin (not _keep): every unlock asks again. -->
  <action id="harbour.twofold.unlock">
    <description>Unlock the Twofold vault</description>
    <message>Confirm to unlock your two-factor codes.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
